# 前端构建期公开配置（GitHub Actions Variables 或本地 .env.local）
# 注意：绝不在前端暴露 Supabase Secret Key 或 GA4 Service Account 私钥！

# 游戏标识（复用母版制作新游戏时修改此值即可复用同一套 Supabase 排行榜表）
VITE_GAME_ID=star-dash-v1

# Google Analytics 4 衡量 ID（形如 G-XXXXXXXXXX）
VITE_GA4_MEASUREMENT_ID=

# 新加坡 Supabase 项目地址与可发布密钥（支持新版 sb_publishable_... 或旧版 anon Key）
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 目标分发门户：auto | poki | crazygames | telegram | standalone
VITE_PORTAL_TARGET=auto
